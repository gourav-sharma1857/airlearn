# Name, tagline and logo live in brand.config.json.
# Formspree form id for the teacher pilot signup (https://formspree.io). Leave empty to show a "not connected yet" note.
VITE_FORMSPREE_ID=
# Link to a feedback form (e.g. a Google Form) shown at the end of the lesson.
VITE_FEEDBACK_URL=
# Optional URL that receives anonymous event counts via navigator.sendBeacon. Leave empty to disable analytics.
VITE_ANALYTICS_ENDPOINT=
